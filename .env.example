# Copiez ce fichier en `.env` et renseignez vos valeurs.
# `.env` est ignoré par Git : n'y mettez jamais de secret dans un commit.

# Clé Google Maps pour Android, obligatoire pour que la carte s'affiche
# en dehors d'Expo Go (builds EAS / APK).
# Console Google Cloud > APIs & Services > Credentials > "Maps SDK for Android".
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=

# Aucune clé n'est nécessaire pour les données open data Loire-Atlantique
# ni pour Overpass : ces API sont publiques.
